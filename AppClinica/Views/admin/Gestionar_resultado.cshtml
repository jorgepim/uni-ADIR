@model IEnumerable<ResultadoTest>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Revisar Resultados";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background-color: #f1f1f1;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        color: #1d3557;
        font-weight: 600;
    }

    .btn-outline-secondary:hover {
        background-color: #a8dadc;
        color: #fff;
        border-color: #a8dadc;
    }

    .form-control:focus {
        border-color: #a8dadc;
        box-shadow: 0 0 0 0.25rem rgba(168, 218, 220, 0.5);
    }

    .table {
        border-radius: 10px;
        overflow: hidden;
    }

        .table th {
            background-color: #a8dadc;
            color: #1d3557;
            font-weight: 600;
        }

        .table td {
            background-color: #ffffff;
        }

    .badge-info {
        background-color: #a8dadc;
        color: #1d3557;
        font-weight: 500;
    }

    .btn-outline-primary {
        border-color: #457b9d;
        color: #457b9d;
    }

        .btn-outline-primary:hover {
            background-color: #457b9d;
            color: #fff;
        }
</style>

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="admin" asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al Dashboard</a>
    </div>

    <h1 class="h4 mb-4">Revisar Resultados</h1>

    <div class="mb-4">
        <input type="text" class="form-control" placeholder="🔍 Buscar por paciente o especialista..." />
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered align-middle mb-0">
            <thead>
                <tr>
                    <th>Paciente</th>
                    <th>Especialista</th>
                    <th>Test</th>
                    <th>Fecha</th>
                    <th>Observaciones</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resultado in Model)
                {
                    <tr>
                        <td>@resultado.Paciente.Nombres</td>
                        <td>@resultado.Especialista.Nombres</td>
                        <td><span class="badge badge-info">@resultado.Test.NombreTest</span></td>
                        <td>@resultado.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                        <td>@resultado.Observaciones</td>
                        <td class="text-end">
                            <a asp-action="Detalles" asp-route-id="@resultado.IdResultado" class="btn btn-sm btn-outline-primary">Ver Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
