@model IEnumerable<ResultadoTest>

@{
    ViewData["Title"] = "Revisar Resultados";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="admin" asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al Dashboard</a>
    </div>

    <h1 class="h4 mb-4">Revisar Resultados</h1>

    <div class="mb-4">
        <input type="text" class="form-control" placeholder="Buscar por paciente o especialista..." />
    </div>

    <div class="table-responsive shadow-sm bg-white rounded">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Paciente</th>
                    <th>Especialista</th>
                    <th>Test</th>
                    <th>Fecha</th>
                    <th>Observaciones</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resultado in Model)
                {
                    <tr>
                        <td>@resultado.Paciente.Nombres</td>
                        <td>@resultado.Especialista.Nombres</td>
                        <td><span class="badge bg-info text-dark">@resultado.Test.NombreTest</span></td>
                        <td><span class="badge bg-info text-dark">@resultado.Test</span></td>
                        <td>@resultado.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                        <td>@resultado.Observaciones</td>
                        <td class="text-end">
                            <a asp-action="Detalles" asp-route-id="@resultado.IdResultado" class="btn btn-sm btn-outline-primary">Ver Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>