@model AppClinica.Models.Especialista

@{
    ViewData["Title"] = "Agregar Especialista";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            padding: 20px;
        }

        .modal-content-custom {
            background-color: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            padding: 30px;
            width: 100%;
            max-width: 600px;
            transition: all 0.3s ease-in-out;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .form-label {
            font-weight: 500;
            color: #333;
        }

        h5 {
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-light">
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
                <h5 class="mb-0 text-primary">Agregar Nuevo Especialista</h5>
                <a asp-controller="Admin" asp-action="Index" class="btn-close"></a>
            </div>

            <form asp-action="Agregar" method="get">
                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="Nombres" class="form-label">Nombres</label>
                        <input asp-for="Nombres" class="form-control" type="text" placeholder="Ingrese nombres" required />
                    </div>
                    <div class="col">
                        <label asp-for="Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control" type="text" placeholder="Ingrese apellidos" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Especialidad" class="form-label">Especialidad</label>
                    <input asp-for="Especialidad" class="form-control" type="text" placeholder="Ej. Psicología infantil" required />
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" type="tel" placeholder="Ej. 7777-8888" pattern="[0-9]{4}-?[0-9]{4}" required />
                    </div>
                    <div class="col">
                        <label asp-for="Direccion" class="form-label">Dirección</label>
                        <input asp-for="Direccion" class="form-control" type="text" placeholder="Dirección completa" required />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Agregar Especialista</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>

