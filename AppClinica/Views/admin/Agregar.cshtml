@model AppClinica.Models.ViewModels.EspecialistaViewModel

@{
    ViewData["Title"] = "Agregar Especialista";
    Layout = null; // Si quieres que sea modal sin layout principal
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            padding: 20px;
        }

        .modal-content-custom {
            background-color: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            padding: 30px;
            width: 100%;
            max-width: 600px;
            transition: all 0.3s ease-in-out;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .form-label {
            font-weight: 500;
            color: #333;
        }

        h5 {
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-light">
    <div class="modal-overlay">
        <div class="bg-white rounded shadow-lg p-4" style="width: 100%; max-width: 550px;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="mb-0 text-primary">Agregar Nuevo Especialista</h5>
                <a asp-controller="Admin" asp-action="Index" class="btn-close" aria-label="Cerrar"></a>
            </div>

            <form asp-action="Agregar" method="post" autocomplete="off">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <h5 class="text-secondary">Datos de Usuario</h5>

                <div class="mb-3">
                    <label asp-for="Usuario.Correo" class="form-label">Correo</label>
                    <input asp-for="Usuario.Correo" class="form-control" type="email" required />
                    <span asp-validation-for="Usuario.Correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Usuario.NombreUsuario" class="form-label">Nombre de Usuario</label>
                    <input asp-for="Usuario.NombreUsuario" class="form-control" required />
                    <span asp-validation-for="Usuario.NombreUsuario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Usuario.Contrasena" class="form-label">Contraseña</label>
                    <input asp-for="Usuario.Contrasena" class="form-control" type="password" required />
                    <span asp-validation-for="Usuario.Contrasena" class="text-danger"></span>
                </div>

                <hr />

                <h5 class="text-secondary">Datos del Especialista</h5>

                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="Especialista.Nombres" class="form-label">Nombres</label>
                        <input asp-for="Especialista.Nombres" class="form-control" required />
                        <span asp-validation-for="Especialista.Nombres" class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label asp-for="Especialista.Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Especialista.Apellidos" class="form-control" required />
                        <span asp-validation-for="Especialista.Apellidos" class="text-danger"></span>
                    </div>
                    <div class="mb-3">

                        <label asp-for="Especialista.Especialidad" class="form-label">Especialidad</label>
                        <select asp-for="Especialista.Especialidad" class="form-select" asp-items="@(new SelectList(Model.EspecialidadesDisponibles))" required>
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="Especialista.Especialidad" class="text-danger"></span>

                    </div>
                    <div class="mb-3">
                        <label asp-for="Especialista.JVPP" class="form-label">Número JVPP</label>
                        <input asp-for="Especialista.JVPP" class="form-control" required />
                        <span asp-validation-for="Especialista.JVPP" class="text-danger"></span>
                    </div>


                    <div class="row mb-3">
                        <div class="col">

                            <label asp-for="Especialista.Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Especialista.Telefono" class="form-control" required />
                            <span asp-validation-for="Especialista.Telefono" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label asp-for="Especialista.Direccion" class="form-label">Dirección</label>
                            <input asp-for="Especialista.Direccion" class="form-control" required />
                            <span asp-validation-for="Especialista.Direccion" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Crear Especialista</button>
                    </div>

                </div>
            </form>

            @* Validaciones del lado del cliente *@
            <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

