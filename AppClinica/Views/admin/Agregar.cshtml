@model AppClinica.Models.Especialista

@{
    ViewData["Title"] = "Agregar Especialista";
    Layout = null; // Si se desea que sea una vista modal sin layout principal
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1050;
        }
    </style>
</head>
<body class="bg-light">
    <div class="modal-overlay">
        <div class="bg-white rounded shadow-lg p-4" style="width: 100%; max-width: 500px;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="mb-0">Agregar Nuevo Especialista</h5>
                <a asp-controller="Admin" asp-action="Index" class="btn-close"></a>
            </div>

            <form asp-action="Agregar" method="get">
            
                <div class="row">
                    <div class="col">
                        <label asp-for="Nombres" class="form-label"></label>
                        <input asp-for="Nombres" class="form-control" type="text" required />
                    </div>
                    <div class="col">
                        <label asp-for="Apellidos" class="form-label"></label>
                        <input asp-for="Apellidos" class="form-control" type="text" required />
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label asp-for="Especialidad" class="form-label"></label>
                    <input asp-for="Especialidad" class="form-control" type="text" required />
                </div>

                <div class="row">
                    <div class="col">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" type="number" min="0" required />
                    </div>
                    <div class="col">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" type="text" required />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Agregar Especialista</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
