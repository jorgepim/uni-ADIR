@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Gestionar Tests";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background-color: #f1f1f1;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        color: #1d3557;
        font-weight: 600;
    }

    .card {
        border-radius: 20px;
        transition: transform 0.2s ease, box-shadow 0.3s ease;
        background-color: #ffffff;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        }

    .card-title {
        color: #1d3557;
        font-weight: 600;
    }

    .card-text {
        font-size: 0.95rem;
    }

    .btn-outline-secondary:hover {
        background-color: #a8dadc;
        color: white;
        border-color: #a8dadc;
    }

    .text-primary {
        color: #457b9d !important;
    }

    .svg-icon {
        margin-bottom: 1rem;
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="admin" asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al Dashboard</a>
    </div>

    <h1 class="h4 mb-4">Gestionar Tests y Preguntas</h1>

    <div class="row g-4">
        <div class="col-md-6">
            <a asp-controller="Preguntas" asp-action="ADI_R" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <div class="svg-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="text-primary" width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 2v20l7-3 7 3V2H6zm2 2h10v14.17l-5-2.14-5 2.14V4z" />
                            </svg>
                        </div>
                        <h5 class="card-title">ADI-R</h5>
                        <p class="card-text text-muted">Entrevista para el Diagnóstico del Autismo - Revisada</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Preguntas" asp-action="ADOS2" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <div class="svg-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="text-primary" width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 2v20l7-3 7 3V2H6zm2 2h10v14.17l-5-2.14-5 2.14V4z" />
                            </svg>
                        </div>
                        <h5 class="card-title">ADOS-2</h5>
                        <p class="card-text text-muted">Escala de Observación para el Diagnóstico del Autismo</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
