@model AppClinica.Models.ViewModels.SeleccionarModuloAdirViewModel

@{
    ViewData["Title"] = "Seleccionar Sección ADI-R";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller=" Evaluaciones" asp-action="Adir" class="btn btn-link">&larr; Volver</a>
    </div>

    <h2 class="text-gradient mb-4">Selecciona una sección del test ADI-R</h2>

    <div class="row g-4">
        @if (Model.Secciones != null && Model.Secciones.Any())
        {
            @foreach (var seccion in Model.Secciones)
            {
                <div class="col-md-4">
                    <a asp-controller="Test"
                       asp-action="IniciarSeccionAdir"
                       asp-route-idSeccion="@seccion.IdSeccion"
                       asp-route-idPaciente="@Model.IdPaciente"
                       class="text-decoration-none">
                        <div class="card card-personalizada text-center p-4 h-100 shadow-sm">
                            <h5 class="card-title">@seccion.NombreSeccion</h5>
                            <p class="card-text text-muted">Sección @seccion.Orden</p>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    No hay secciones disponibles para el test ADI-R.
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card-personalizada {
        background-color: #f1f1f1;
        border: none;
        border-radius: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-personalizada:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

    .card-title {
        color: #1d3557;
        font-weight: 600;
    }

    .card-text {
        font-size: 0.9rem;
    }
</style>
