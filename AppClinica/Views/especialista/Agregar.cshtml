@model AppClinica.Models.Paciente

@{
    ViewData["Title"] = "Agregar Paciente";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
}

<div class="mb-3">
    <a asp-controller="Especialista" asp-action="Index" class="btn btn-link text-decoration-none">&larr; Volver al Dashboard</a>
</div>

<form asp-action="Agregar" method="post" class="row g-4">
    @Html.AntiForgeryToken()
    <div class="col-12 col-md-6">
        <label asp-for="Correo" class="form-label fw-semibold text-gradient">Correo Electrónico</label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Nombres" class="form-label fw-semibold text-gradient">Nombres</label>
        <input asp-for="Nombres" class="form-control" />
        <span asp-validation-for="Nombres" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Apellidos" class="form-label fw-semibold text-gradient">Apellidos</label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="FechaNacimiento" class="form-label fw-semibold text-gradient">Fecha de Nacimiento</label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Sexo" class="form-label fw-semibold text-gradient">Sexo</label>
        <select asp-for="Sexo" class="form-select">
            <option value="">Seleccione</option>
            <option value="M">Masculino</option>
            <option value="F">Femenino</option>
        </select>
        <span asp-validation-for="Sexo" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Responsable" class="form-label fw-semibold text-gradient">Responsable</label>
        <input asp-for="Responsable" class="form-control" />
        <span asp-validation-for="Responsable" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Direccion" class="form-label fw-semibold text-gradient">Dirección</label>
        <textarea asp-for="Direccion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>

    <div class="col-12 text-end">
        <button type="submit" class="btn btn-modern btn-primary-modern">
            <i class="fas fa-save me-2"></i>Guardar Paciente
        </button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
