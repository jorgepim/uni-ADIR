@model AppClinica.Models.ViewModels.SeleccionarModuloAdirViewModel

@{
    ViewData["Title"] = "Seleccionar Módulo ADI-R";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
}

<div class="container py-5">
    <a asp-controller="Evaluaciones" asp-action="SeleccionarTest" asp-route-idPaciente="@Model.IdPaciente" class="btn btn-link mb-4">
        &larr; Volver
    </a>

    <h2 class="fw-bold text-primary mb-4">Seleccionar Módulo de Evaluación</h2>
    <p class="mb-4">Paciente: <strong>@ViewBag.NombrePaciente</strong></p>

    <div class="row g-4">
        @foreach (var seccion in Model.Secciones)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold">ADI-R: @seccion.NombreSeccion</h5>
                            <p class="card-text text-muted">@seccion.NombreSeccion ?? "Evaluación de esta sección del ADI-R."</p>
                            <p class="text-muted small">
                                <i class="bi bi-clock"></i> Tiempo estimado: @((seccion.IdSeccion))
                            </p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Test"
                               asp-action="Preguntas"
                               asp-route-idSeccion="@seccion.IdSeccion"
                               asp-route-idPaciente="@Model.IdPaciente"
                               class="btn btn-primary w-100 rounded-pill">
                                Iniciar evaluación
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
