@model AppClinica.Models.Usuario
@{
    ViewData["Title"] = "Registrarse";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f1f1f1;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .register-card {
            background-color: #ffffff;
            border-radius: 20px;
            padding: 2.5rem;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .form-label {
            font-weight: 600;
            color: #1d3557;
        }

        .form-control:focus {
            border-color: #a8dadc;
            box-shadow: 0 0 0 0.25rem rgba(168, 218, 220, 0.4);
        }

        .btn-primary {
            background-color: #457b9d;
            border-color: #457b9d;
        }

            .btn-primary:hover {
                background-color: #345a75;
                border-color: #345a75;
            }

        .text-link {
            color: #457b9d;
            font-weight: 500;
            text-decoration: none;
        }

            .text-link:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <h2 class="text-center mb-4">@ViewData["Title"]</h2>

            <form asp-action="Registro" method="post" autocomplete="off">
                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label"></label>
                    <input asp-for="NombreUsuario" class="form-control" placeholder="Ingresa tu nombre de usuario" />
                    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" placeholder="Ingresa tu correo electrónico" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RolId" class="form-label">Rol</label>
                    <select asp-for="RolId" class="form-select" asp-items="ViewBag.Roles">
                        <option value="">Seleccione un rol</option>
                        <option value="1">Administrador</option>
                        <option value="2">Especialista</option>
                    </select>
                    <span asp-validation-for="RolId" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" type="password" placeholder="Crea una contraseña segura" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Registrarse</button>
            </form>

            <div class="mt-4 text-center text-muted">
                ¿Ya tienes una cuenta? <a asp-action="Login" asp-controller="Auth" class="text-link">Inicia sesión</a>
            </div>
        </div>
    </div>

    @* Validaciones del lado del cliente *@
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
