@model AppClinica.Models.Usuario
<h2>@ViewData["Title"]</h2>

<form asp-action="Registro" method="post">
    <div class="form-group">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" placeholder="Ingresa tu nombre de usuario" />
        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" class="form-control" placeholder="Ingresa tu correo electrónico" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="RolId">Rol</label>
        <select asp-for="RolId" class="form-control" asp-items="ViewBag.Roles">
            <option value="">Seleccione un rol</option>
        </select>
        <span asp-validation-for="RolId" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Contrasena"></label>
        <input asp-for="Contrasena" class="form-control" type="password" placeholder="Crea una contraseña segura" />
        <span asp-validation-for="Contrasena" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Registrarse</button>
</form>

<div class="mt-3">
    ¿Ya tienes una cuenta? <a asp-action="Login" asp-controller="Auth">Inicia sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}