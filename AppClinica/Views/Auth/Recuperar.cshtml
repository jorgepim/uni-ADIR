@model AppClinica.Models.ViewModels.RecuperarViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recuperar Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%;">
            <div class="text-center mb-4">
                <h3 class="text-primary">¿Olvidaste tu contraseña?</h3>
                <p class="text-muted">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>
            </div>

            <form asp-action="Recuperar" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <input asp-for="Correo" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Enviar enlace</button>
                </div>
            </form>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-info mt-3 text-center">@ViewBag.Mensaje</div>
            }
        </div>
    </div>

</body>
</html>

