@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f1f1f1;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-card {
            background-color: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
        }

            .login-card h2 {
                font-weight: 700;
                color: #1d3557;
                margin-bottom: 1.5rem;
            }

        .form-label {
            font-weight: 600;
            color: #1d3557;
        }

        .form-control:focus {
            border-color: #a8dadc;
            box-shadow: 0 0 0 0.25rem rgba(168, 218, 220, 0.4);
        }

        .btn-primary {
            background-color: #457b9d;
            border-color: #457b9d;
        }

            .btn-primary:hover {
                background-color: #345a75;
                border-color: #345a75;
            }

        .text-muted a {
            color: #457b9d;
            font-weight: 500;
            text-decoration: none;
        }

            .text-muted a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-card">
            <h2 class="text-center">Iniciar Sesión</h2>

            <form asp-action="Login" method="post" autocomplete="off">
                <div class="mb-3">
                    <label for="correo" class="form-label">Correo Electrónico</label>
                    <input name="correo" id="correo" class="form-control" placeholder="Ingresa tu correo" required />
                </div>

                <div class="mb-3">
                    <label for="clave" class="form-label">Contraseña</label>
                    <input name="clave" id="clave" type="password" class="form-control" placeholder="Ingresa tu contraseña" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-2">Iniciar Sesión</button>
            </form>

            <div class="mt-4 text-center text-muted">
                ¿No tienes una cuenta? <a asp-controller="Auth" asp-action="Registro">Regístrate aquí</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
