@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión</title>

    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .login-container {
            height: 100dvh;
        }
    </style>
</head>
<body>

    <div class="d-flex justify-content-center align-items-center login-container">
        <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px;">
            <h2 class="text-center mb-4">Iniciar Sesión</h2>

            <form asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label for="correo" class="form-label">Correo Electrónico</label>
                    <input name="correo" class="form-control" placeholder="Ingresa tu correo" required />
                </div>

                <div class="form-group mb-3">
                    <label for="clave" class="form-label">Contraseña</label>
                    <input name="clave" type="password" class="form-control" placeholder="Ingresa tu contraseña" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
            </form>

            <div class="mt-3 text-center">
                ¿No tienes una cuenta? <a asp-action="Registro" asp-controller="Auth">Regístrate aquí</a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (opcional si no usas dropdowns/modales) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
