

@model List<AppClinica.Models.ViewModels.PreguntaConOpcionesViewModel>

@{
    ViewData["Title"] = "Preguntas del Módulo ADOS-2";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="especialista" asp-action="TestAdos" asp-route-idPaciente="@ViewBag.IdPaciente" class="btn btn-outline-secondary">&larr; Volver</a>
    </div>

    <h2 class="text-center mb-4">Módulo ADOS-2: @ViewBag.Modulo</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No hay preguntas registradas para este módulo.</div>
    }
    else
    {
        <form method="post" asp-action="GuardarRespuestas">
            @for (int i = 0; i < Model.Count; i++)
            {
                var pregunta = Model[i];
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">(@pregunta.Orden) @pregunta.TextoPregunta</h5>

                        @if (pregunta.TipoRespuesta == "opcion")
                        {
                            foreach (var opcion in pregunta.Opciones)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           name="Respuestas[@i].IdOpcionSeleccionada"
                                           value="@opcion.IdOpcion"
                                           id="opcion_@opcion.IdOpcion" @(opcion == pregunta.Opciones.First() ? "required" : "")/>
                                    <label class="form-check-label" for="opcion_@opcion.IdOpcion">
                                        (@opcion.Codigo) @opcion.Descripcion
                                    </label>
                                </div>
                            }
                        }

                        <input type="hidden" name="Respuestas[@i].IdPregunta" value="@pregunta.IdPregunta" />
                    </div>
                </div>
            }

            <button type="submit" class="btn btn-primary">Guardar respuestas</button>
        </form>
    }
</div>

