@model AppClinica.Models.Especialista
@{
    ViewData["Title"] = "Consentimiento del Especialista";
    var nombreCompleto = $"{ViewBag.EspecialistaDesencriptado.Nombres} {ViewBag.EspecialistaDesencriptado.Apellidos}";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #2563eb;
            --secondary-color: #1e40af;
            --success-color: #059669;
            --info-color: #0891b2;
            --warning-color: #d97706;
            --danger-color: #dc2626;
            --dark-color: #1f2937;
            --light-color: #f8fafc;
            --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-secondary: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
            --shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            --shadow-hover: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--gradient-primary);
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            padding: 2rem 0;
            position: relative;
        }

            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
                pointer-events: none;
            }

        .document-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 1rem;
            position: relative;
            z-index: 1;
        }

        .document-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            box-shadow: var(--shadow-hover);
            overflow: hidden;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .document-header {
            background: var(--gradient-secondary);
            color: white;
            padding: 2.5rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .document-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
                animation: rotate 20s linear infinite;
            }

        @@keyframes rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .document-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 2;
        }

        .document-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            position: relative;
            z-index: 2;
        }

        .document-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.9;
            position: relative;
            z-index: 2;
        }

        .document-body {
            padding: 3rem 2.5rem;
        }

        .professional-info {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-left: 4px solid var(--primary-color);
            position: relative;
            overflow: hidden;
        }

            .professional-info::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100px;
                height: 100px;
                background: rgba(37, 99, 235, 0.05);
                border-radius: 50%;
                transform: translate(25%, -25%);
            }

            .professional-info h4 {
                color: var(--primary-color);
                font-weight: 600;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

            .info-item i {
                color: var(--primary-color);
                width: 20px;
                margin-right: 0.75rem;
            }

        .obligations-section {
            margin: 2.5rem 0;
        }

        .obligations-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .obligations-list {
            list-style: none;
            padding: 0;
        }

        .obligation-item {
            background: rgba(37, 99, 235, 0.03);
            border-left: 3px solid var(--primary-color);
            padding: 1rem 1.5rem;
            margin-bottom: 1rem;
            border-radius: 0 12px 12px 0;
            transition: all 0.3s ease;
            position: relative;
        }

            .obligation-item:hover {
                background: rgba(37, 99, 235, 0.08);
                transform: translateX(5px);
            }

            .obligation-item::before {
                content: counter(obligation-counter);
                counter-increment: obligation-counter;
                position: absolute;
                left: -15px;
                top: 50%;
                transform: translateY(-50%);
                background: var(--primary-color);
                color: white;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 0.875rem;
            }

        .obligations-list {
            counter-reset: obligation-counter;
        }

        .commitment-section {
            background: linear-gradient(135deg, #fef3c7 0%, #fed7aa 100%);
            border-radius: 16px;
            padding: 2rem;
            margin: 2rem 0;
            border: 1px solid rgba(217, 119, 6, 0.2);
            position: relative;
        }

            .commitment-section::before {
                content: '\f06a';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                position: absolute;
                top: 1rem;
                right: 1.5rem;
                font-size: 2rem;
                color: var(--warning-color);
                opacity: 0.3;
            }

        .form-section {
            background: rgba(249, 250, 251, 0.8);
            border-radius: 16px;
            padding: 2rem;
            margin-top: 2.5rem;
            border: 1px solid rgba(229, 231, 235, 0.5);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-control {
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.9);
        }

            .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.15);
                background: white;
            }

        .form-check {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            border: 2px solid #e5e7eb;
            transition: all 0.3s ease;
            margin: 1.5rem 0;
        }

            .form-check:hover {
                border-color: var(--primary-color);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
            }

        .form-check-input {
            width: 1.25rem;
            height: 1.25rem;
            margin-right: 0.75rem;
            border: 2px solid var(--primary-color);
        }

            .form-check-input:checked {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

        .form-check-label {
            font-weight: 500;
            color: var(--dark-color);
            cursor: pointer;
            line-height: 1.5;
        }

        .submit-section {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(229, 231, 235, 0.5);
            margin-top: 2rem;
        }

        .btn-accept {
            background: linear-gradient(135deg, var(--success-color) 0%, #047857 100%);
            color: white;
            border: none;
            padding: 1rem 2.5rem;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);
            position: relative;
            overflow: hidden;
        }

            .btn-accept::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s ease;
            }

            .btn-accept:hover::before {
                left: 100%;
            }

            .btn-accept:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(5, 150, 105, 0.4);
            }

            .btn-accept:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .legal-footer {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(229, 231, 235, 0.5);
            font-size: 0.875rem;
            color: #6b7280;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .document-container

        {
            padding: 0 0.5rem;
        }

        .document-header {
            padding: 2rem 1.5rem;
        }

        .document-title {
            font-size: 1.5rem;
        }

        .document-body {
            padding: 2rem 1.5rem;
        }

        .professional-info,
        .form-section,
        .commitment-section {
            padding: 1.5rem;
        }

        }

        /* Animaciones de entrada */
        .obligation-item {
            animation: slideInLeft 0.6s ease-out backwards;
        }

            .obligation-item:nth-child(1) {
                animation-delay: 0.1s;
            }

            .obligation-item:nth-child(2) {
                animation-delay: 0.2s;
            }

            .obligation-item:nth-child(3) {
                animation-delay: 0.3s;
            }

            .obligation-item:nth-child(4) {
                animation-delay: 0.4s;
            }

            .obligation-item:nth-child(5) {
                animation-delay: 0.5s;
            }

        @@keyframes slideInLeft {
            from

        {
            opacity: 0;
            transform: translateX(-30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }
    </style>
</head>
<body>
    <div class="document-container">
        <div class="document-card">
            <div class="document-header">
                <div class="document-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h1 class="document-title">Acta de Consentimiento Profesional</h1>
                <p class="document-subtitle">Especialista en el Sistema TEA</p>
            </div>

            <div class="document-body">
                <div class="professional-info">
                    <h4>
                        <i class="fas fa-user-md"></i>
                        Información del Especialista
                    </h4>
                    <div class="info-item">
                        <i class="fas fa-user"></i>
                        <strong>@nombreCompleto</strong>
                    </div>
                    <div class="info-item">
                        <i class="fas fa-certificate"></i>
                        <strong>JVPP: @Model.JVPP</strong>
                    </div>
                    <div class="info-item">
                        <i class="fas fa-stethoscope"></i>
                        <strong>Especialidad: @Model.Especialidad</strong>
                    </div>
                </div>

                <div class="content-section">
                    <p class="lead">
                        Yo, <strong>@nombreCompleto</strong>, identificado con número JVPP <strong>@Model.JVPP</strong>,
                        declaro que he sido informado sobre mis responsabilidades como profesional de la salud que
                        accede a datos sensibles de pacientes en el sistema TEA.
                    </p>
                </div>

                <div class="obligations-section">
                    <h3 class="obligations-title">
                        <i class="fas fa-clipboard-check"></i>
                        Obligaciones Profesionales
                    </h3>
                    <ul class="obligations-list">
                        <li class="obligation-item">
                            Tratar los datos clínicos y personales exclusivamente con fines diagnósticos y terapéuticos autorizados.
                        </li>
                        <li class="obligation-item">
                            Respetar la confidencialidad de la información y no divulgarla sin autorización previa del paciente/responsable.
                        </li>
                        <li class="obligation-item">
                            Guardar las medidas de seguridad necesarias conforme a la Ley de Protección de Datos Personales y la norma ISO/IEC 27701.
                        </li>
                        <li class="obligation-item">
                            Reportar de forma inmediata cualquier incidente de seguridad que afecte la confidencialidad, integridad o disponibilidad de los datos.
                        </li>
                        <li class="obligation-item">
                            Actualizar y proteger mis credenciales de acceso al sistema clínico.
                        </li>
                    </ul>
                </div>

                <div class="commitment-section">
                    <h4 style="color: var(--warning-color); margin-bottom: 1rem;">
                        <i class="fas fa-exclamation-triangle"></i>
                        Compromiso Legal
                    </h4>
                    <p>
                        Entiendo que este consentimiento estará vigente mientras mantenga un rol activo en el sistema
                        y podrá ser renovado o revocado según las políticas institucionales. El incumplimiento de estas
                        obligaciones puede resultar en sanciones legales y disciplinarias.
                    </p>
                </div>

                <form asp-action="ConfirmarConsentimientoEspecialista" method="post" id="consentForm">
                    <input type="hidden" name="idUsuario" value="@Model.IdUsuario" />

                    <div class="form-section">
                        <div class="form-group">
                            <label for="nombreFirmante" class="form-label">
                                <i class="fas fa-signature"></i>
                                Nombre del especialista:
                            </label>
                            <input type="text" name="nombreFirmante" class="form-control"
                                   value="@nombreCompleto" readonly />
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="consentimientoEsp" required />
                            <label class="form-check-label" for="consentimientoEsp">
                                <strong>Acepto y me comprometo</strong> a cumplir con las obligaciones legales y éticas aquí descritas.
                                Confirmo que he leído, entendido y acepto todos los términos establecidos en este documento.
                            </label>
                        </div>

                        <div class="submit-section">
                            <button type="submit" class="btn-accept" id="submitBtn" disabled>
                                <i class="fas fa-file-signature"></i>
                                Aceptar y Generar Acta
                            </button>
                        </div>
                    </div>
                </form>

                <div class="legal-footer">
                    <p>
                        <i class="fas fa-gavel"></i>
                        Este documento se rige por las leyes de El Salvador y las normativas internacionales de protección de datos.
                        <br>
                        Fecha de generación: <strong id="currentDate"></strong>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mostrar fecha actual
            const currentDate = new Date().toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('currentDate').textContent = currentDate;

            // Habilitar/deshabilitar botón según checkbox
            const checkbox = document.getElementById('consentimientoEsp');
            const submitBtn = document.getElementById('submitBtn');

            checkbox.addEventListener('change', function() {
                submitBtn.disabled = !this.checked;
            });

            // Efecto de loading al enviar
            document.getElementById('consentForm').addEventListener('submit', function() {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando...';
                submitBtn.disabled = true;
            });
        });
    </script>
</body>
</html>