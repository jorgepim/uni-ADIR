@* Layout exclusivo para Admin *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin - AppClinica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-light bg-white shadow-sm px-4">
        <span class="navbar-brand mb-0 h1">Panel de Administración TEA</span>
        <div>
            <a asp-controller="Admin" asp-action="Agregar" class="btn btn-primary me-2">Agregar Especialista</a>
            <a asp-controller="admin" asp-action="Logout" class="btn btn-outline-secondary">Cerrar Sesión</a>
        </div>
    </nav>
    <div class="container mt-3">
        @RenderBody()
    </div>
</body>
</html>
