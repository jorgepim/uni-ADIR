@* Layout exclusivo para Admin - Versión Modernizada *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin - AppClinica</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --admin-primary: #7c3aed;
            --admin-primary-hover: #6d28d9;
            --admin-secondary: #64748b;
            --admin-accent: #a855f7;
            --admin-success: #10b981;
            --admin-warning: #f59e0b;
            --admin-danger: #ef4444;
            --admin-dark: #1e1b4b;
            --admin-light-bg: #faf7ff;
            --admin-card-shadow: 0 4px 6px -1px rgba(139, 92, 246, 0.1), 0 2px 4px -1px rgba(139, 92, 246, 0.06);
            --admin-border-radius: 16px;
            --admin-header-height: 85px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #faf7ff 0%, #f3e8ff 50%, #ede9fe 100%);
            min-height: 100vh;
            color: var(--admin-dark);
            line-height: 1.6;
        }

        /* Admin Header Styles */
        .admin-header {
            background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
            backdrop-filter: blur(15px);
            border-bottom: 2px solid rgba(168, 85, 247, 0.1);
            box-shadow: 0 8px 32px rgba(139, 92, 246, 0.15);
            position: sticky;
            top: 0;
            z-index: 1000;
            height: var(--admin-header-height);
        }

        .admin-navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: var(--admin-dark) !important;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-brand-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--admin-primary), var(--admin-accent));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
        }

        .admin-badge {
            background: linear-gradient(135deg, #ff6b6b, #ee5a52);
            color: white;
            font-size: 0.75rem;
            padding: 4px 8px;
            border-radius: 20px;
            font-weight: 600;
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 20px;
            text-align: center;
        }

        /* Admin Modern Buttons */
        .btn-admin-modern {
            font-weight: 600;
            border-radius: 12px;
            padding: 14px 28px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            position: relative;
            overflow: hidden;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
        }

        .btn-admin-primary {
            background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-hover));
            color: white;
            box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4);
        }

            .btn-admin-primary:hover {
                background: linear-gradient(135deg, var(--admin-primary-hover), #5b21b6);
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(124, 58, 237, 0.5);
                color: white;
            }

        .btn-admin-outline {
            background: rgba(255, 255, 255, 0.9);
            color: var(--admin-primary);
            border: 2px solid rgba(124, 58, 237, 0.3);
            backdrop-filter: blur(10px);
        }

            .btn-admin-outline:hover {
                background: var(--admin-primary);
                color: white;
                border-color: var(--admin-primary);
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(124, 58, 237, 0.4);
            }

        /* Admin Main Content */
        .admin-main-content {
            padding: 2.5rem 0;
            min-height: calc(100vh - var(--admin-header-height));
        }

        .admin-content-wrapper {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            border-radius: var(--admin-border-radius);
            box-shadow: var(--admin-card-shadow);
            padding: 2.5rem;
            margin-top: 1.5rem;
            border: 1px solid rgba(168, 85, 247, 0.1);
            position: relative;
            overflow: hidden;
        }

            .admin-content-wrapper::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--admin-primary), var(--admin-accent));
                border-radius: var(--admin-border-radius) var(--admin-border-radius) 0 0;
            }

        /* Admin Stats Cards */
        .admin-stat-card {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.1);
            border: 1px solid rgba(168, 85, 247, 0.15);
            transition: all 0.3s ease;
        }

            .admin-stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(124, 58, 237, 0.2);
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .admin-navbar-brand

        {
            font-size: 1.3rem;
        }

        .admin-brand-icon {
            width: 40px;
            height: 40px;
            font-size: 1.1rem;
        }

        .btn-admin-modern {
            padding: 12px 24px;
            font-size: 0.9rem;
        }

        .admin-header-actions {
            flex-direction: column;
            gap: 0.75rem;
        }

            .admin-header-actions .btn-admin-modern {
                width: 100%;
                justify-content: center;
            }

        }

        /* Admin Animations */
        @@keyframes adminFadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .admin-fade-in-up {
            animation: adminFadeInUp 0.7s ease-out;
        }

        /* Admin Utility Classes */
        .admin-text-gradient {
            background: linear-gradient(135deg, var(--admin-primary), var(--admin-accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .admin-glass-effect {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Admin Navigation Enhancement */
        .admin-nav-item {
            position: relative;
            margin: 0 0.5rem;
        }

            .admin-nav-item::after {
                content: '';
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--admin-primary), var(--admin-accent));
                border-radius: 2px;
                transition: width 0.3s ease;
            }

            .admin-nav-item:hover::after {
                width: 100%;
            }
    </style>
</head>
<body>
    <header class="admin-header">
        <nav class="navbar navbar-expand-lg h-100">
            <div class="container-fluid h-100">
                <div class="d-flex justify-content-between align-items-center w-100 h-100">
                    <div class="admin-navbar-brand">
                        <div class="admin-brand-icon position-relative">
                            <i class="fas fa-user-shield"></i>
                            <span class="admin-badge">A</span>
                        </div>
                        <span>Panel <span class="admin-text-gradient">Administración</span> TEA</span>
                    </div>

                    <div class="admin-header-actions d-flex align-items-center gap-3">
                        <div class="admin-nav-item">
                            <a asp-controller="admin" asp-action="Agregar" class="btn btn-admin-modern btn-admin-primary">
                                <i class="fas fa-user-plus"></i>
                                Agregar Especialista
                            </a>
                        </div>
                        <div class="admin-nav-item">
                            <a asp-controller="admin" asp-action="Logout" class="btn btn-admin-modern btn-admin-outline">
                                <i class="fas fa-sign-out-alt"></i>
                                Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="admin-main-content">
        <div class="container">
            <div class="admin-content-wrapper admin-fade-in-up">
                @RenderBody()
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Efecto dinámico en el header al hacer scroll
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const header = document.querySelector('.admin-header');
            if (scrolled > 50) {
                header.style.background = 'rgba(255, 255, 255, 0.95)';
                header.style.backdropFilter = 'blur(20px)';
                header.style.boxShadow = '0 12px 40px rgba(139, 92, 246, 0.2)';
            } else {
                header.style.background = 'linear-gradient(135deg, #ffffff 0%, #faf5ff 100%)';
                header.style.backdropFilter = 'blur(15px)';
                header.style.boxShadow = '0 8px 32px rgba(139, 92, 246, 0.15)';
            }
        });

        // Animaciones de entrada
        document.addEventListener('DOMContentLoaded', () => {
            const elements = document.querySelectorAll('.admin-fade-in-up');
            elements.forEach((el, index) => {
                el.style.animationDelay = `${index * 0.15}s`;
            });

            // Efecto de partículas sutil en el fondo
            createParticles();
        });

        function createParticles() {
            const particlesContainer = document.createElement('div');
            particlesContainer.style.position = 'fixed';
            particlesContainer.style.top = '0';
            particlesContainer.style.left = '0';
            particlesContainer.style.width = '100%';
            particlesContainer.style.height = '100%';
            particlesContainer.style.pointerEvents = 'none';
            particlesContainer.style.zIndex = '-1';
            document.body.appendChild(particlesContainer);

            for (let i = 0; i < 20; i++) {
                const particle = document.createElement('div');
                particle.style.position = 'absolute';
                particle.style.width = '4px';
                particle.style.height = '4px';
                particle.style.background = 'rgba(124, 58, 237, 0.1)';
                particle.style.borderRadius = '50%';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.animation = `float ${3 + Math.random() * 4}s ease-in-out infinite`;
                particlesContainer.appendChild(particle);
            }
        }

        // CSS Animation for particles
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes float {
                0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.3; }
                50% { transform: translateY(-20px) rotate(180deg); opacity: 0.8; }
            }
        `;
        document.head.appendChild(style);
    </script>

    @* Permite que los scripts como toggleClave() se ejecuten correctamente *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>