@model AppClinica.Models.ViewModels.SeleccionarModuloAdirViewModel
@inject AppClinica.Services.IAesEncryptionService _aes

@{
    ViewData["Title"] = "Módulos ADI-R";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";

    string nombreCompleto = $"{_aes.Desencriptar(Model.NombreEncriptado)} {_aes.Desencriptar(Model.ApellidoEncriptado)}";
}

<div class="container py-5">
    <a asp-controller="Evaluaciones" asp-action="SeleccionarTest" asp-route-idPaciente="@Model.IdPaciente" class="btn btn-link mb-4">&larr; Volver</a>

    <h2 class="fw-bold text-primary mb-2">Seleccionar Módulo de Evaluación</h2>
    <p>Paciente: <strong>@nombreCompleto</strong></p>

    <div class="row g-4 mt-4">
        @foreach (var seccion in Model.Secciones)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold">@seccion.NombreSeccion</h5>
                            <p class="text-muted small">Módulo @seccion.Orden</p>
                            <p class="text-muted small">
                                @($"{seccion.Preguntas?.Count ?? 0} preguntas")
                            </p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Evaluaciones"
                               asp-action="Preguntas"
                               asp-route-idSeccion="@seccion.IdSeccion"
                               asp-route-idPaciente="@Model.IdPaciente"
                               class="btn btn-primary w-100 rounded-pill">
                                Iniciar evaluación
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
